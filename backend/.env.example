# Copie este arquivo para ".env" (mesma pasta) e preencha com as suas
# credenciais LOCAIS do PostgreSQL. O arquivo ".env" nunca deve ser
# commitado (já está no .gitignore) — cada integrante do grupo mantém
# o seu próprio, com a própria senha.

PGHOST=localhost
PGPORT=5432
PGDATABASE=petcerto
PGUSER=postgres
PGPASSWORD=coloque_sua_senha_aqui

# Opcional: só preencha se quiser que o backend crie um administrador
# automaticamente na primeira execução. Sem essas duas linhas, nenhum
# admin é criado sozinho (evita ter uma senha de admin fixa no código,
# igual em todo mundo que clonar o projeto). Escolha a sua própria senha.
ADMIN_EMAIL=
ADMIN_SENHA=

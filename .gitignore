# Variáveis de ambiente (nunca versionar — cada pessoa usa a própria)
.env
.env.*
!.env.example

# Banco de dados local (gerado em tempo de execução, não versionar)
backend/data/*.db
*.sqlite3

# Dependências e build do frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDEs
.vscode/*
!.vscode/extensions.json
.idea/

# Sistema operacional
.DS_Store
Thumbs.db

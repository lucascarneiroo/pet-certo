# Ambientes virtuais Python
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Cache e artefatos do Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
